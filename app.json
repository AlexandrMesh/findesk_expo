{
  "expo": {
    "name": "FinDesk",
    "slug": "findesk",
    "version": "3.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "findesk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#143757",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "windowSoftInputMode": "adjustResize",
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.findesk",
      "usesCleartextTraffic": true,
      "versionCode": 7
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/e424bca8-36c3-4c32-8501-87743a4e9c97",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "./plugins/remove-adid-permission",
      "./plugins/withAndroidNetworkSecurityConfig",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09172a",
          "dark": {
            "backgroundColor": "#09172a"
          }
        }
      ]
    ],
    "experiments": {},
    "extra": {
      "eas": {
        "projectId": "e424bca8-36c3-4c32-8501-87743a4e9c97"
      }
    },
    "owner": "meshok"
  }
}
